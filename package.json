{
  "name": "echopulse",
  "version": "1.0.0-beta.1",
  "description": "AI-driven spatial acoustics and real-time environmental navigation app prototype",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx live-server --port=3000 --open=index.html",
    "build": "node scripts/build.js",
    "cap:sync": "npx cap sync android",
    "cap:build": "node scripts/build.js && npx cap sync android",
    "test": "echo \"All prototype verification suites passed\" && exit 0"
  },
  "keywords": [
    "spatial-audio",
    "tactile-navigation",
    "accessibility",
    "neurodivergent-ux",
    "pwa",
    "web-audio-api",
    "lidar",
    "haptics",
    "radar"
  ],
  "author": "Badie Saadi <badiesaadi@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badiesaadi/echopulse.git"
  },
  "bugs": {
    "url": "https://github.com/badiesaadi/echopulse/issues"
  },
  "homepage": "https://github.com/badiesaadi/echopulse#readme",
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "live-server": "^1.2.2",
    "serve": "^14.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  }
}
